# ================= Backend =================
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=globetrotter

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS origin of the frontend dev server
CLIENT_URL=http://localhost:5173

# ================= Frontend =================
# Base URL of the REST API consumed by the React app
VITE_API_URL=http://localhost:5000/api
